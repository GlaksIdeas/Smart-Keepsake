# Runs the keepsake server at boot.
# Install: sudo cp keepsake.service /etc/systemd/system/ && sudo systemctl enable --now keepsake
[Unit]
Description=Smart keepsake server
After=network-online.target
Wants=network-online.target

[Service]
User=pi
WorkingDirectory=/home/pi/keepsake
ExecStart=/usr/bin/node server.js
Environment=PORT=8080
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
