# Shows the keepsake screen full screen at boot (no desktop needed).
# Install: sudo cp keepsake-kiosk.service /etc/systemd/system/ && sudo systemctl enable --now keepsake-kiosk
# For a round screen add: Environment=KEEPSAKE_SHAPE=round
[Unit]
Description=Smart keepsake screen
After=keepsake.service systemd-user-sessions.service
Wants=keepsake.service

[Service]
User=pi
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
Environment=XDG_RUNTIME_DIR=/run/user/1000
ExecStart=/usr/bin/cage -s -- /home/pi/keepsake/hardware/kiosk.sh
Restart=always
RestartSec=3

[Install]
WantedBy=graphical.target
